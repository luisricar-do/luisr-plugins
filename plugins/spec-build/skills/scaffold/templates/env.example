# Copie para .env e preencha. Nunca commite o .env.
# Em produção estes valores vêm do cofre de segredos do provedor ou do secret do ambiente.

NODE_ENV=development
PORT=3001

# Postgres local (docker compose). Host remoto aqui = pare e confira se não é produção.
DATABASE_URL=postgres://app:app@localhost:5432/<slug>

# OIDC
OIDC_ISSUER=http://localhost:8080/realms/<slug>
OIDC_AUDIENCE=<slug>-api

# Só desenvolvimento. O boot recusa subir com isto ligado em production.
AUTH_DEV_BYPASS=false
